{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cworkspace",
  "version": "0.1.1",
  "identifier": "com.jcode.cowork",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cworkspace",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#f3f2ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/jcode"],
    "shortDescription": "A desktop workspace for knowledge work, powered by the jcode daemon",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
